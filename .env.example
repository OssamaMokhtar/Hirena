# Hirena environment. Copy to .env.local. Never commit real values.

# auto (default): try OpenAI, fall back to the labelled rule-based estimator
# mock: always use the rule-based estimator
# production: OpenAI only; fail if unavailable
AI_MODE=auto

# Needed for live AI inference. Rotate immediately if it ever leaks.
OPENAI_API_KEY=

# Optional: Supabase for auth and saved assessments
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
